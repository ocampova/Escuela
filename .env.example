DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scs"
# Al menos 32 caracteres aleatorios (ej.: openssl rand -hex 32)
AUTH_SECRET="cambie-esto-por-un-secreto-de-32-caracteres-o-mas"

# URL pública de la app (para los enlaces de invitación). En Railway se toma de RAILWAY_PUBLIC_DOMAIN.
APP_URL="http://localhost:3000"
# Opcional: correo con Resend (https://resend.com). Sin clave, los enlaces se comparten por WhatsApp o copiando.
RESEND_API_KEY=""
MAIL_FROM="San Cayetano School <no-responder@su-dominio.cr>"

# Notificaciones push. Genere las claves una sola vez con: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:scayetanoschool@gmail.com"
