# Base de datos PostgreSQL (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Secreto de sesiones, 32+ caracteres aleatorios (en Railway: ${{secret(48)}}; local: openssl rand -hex 32)
AUTH_SECRET=
# Datos de demostración al arrancar con base vacía (true / vacío)
SEED_DEMO=

# --- Opcionales ---
# URL pública solo si usa un dominio propio (en Railway se toma sola de RAILWAY_PUBLIC_DOMAIN)
# APP_URL=https://plataforma.su-dominio.cr
# Correo con Resend (https://resend.com)
# RESEND_API_KEY=
# MAIL_FROM=San Cayetano School <avisos@avisos.sancayetano.cr>
# MAIL_REPLY_TO=scayetanoschool@gmail.com
# Notificaciones push: si no se definen, se generan solas y se guardan en la base
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:scayetanoschool@gmail.com

# Recordatorios de cobro diarios: secreto para llamar POST /api/cron/recordatorios (opcional si usa Railway Cron con npm run recordatorios)
# CRON_SECRET=
