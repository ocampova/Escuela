generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  TEACHER
  GUARDIAN
}

enum Audience {
  SCHOOL
  LEVEL
  SECTION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TokenPurpose {
  INVITE
  RESET
}

enum ApplicantStatus {
  NEW
  CONTACTED
  VISIT
  ACCEPTED
  ENROLLED
  REJECTED
}

enum PaymentMethod {
  BANCO_POPULAR
  SINPE
  TRANSFER
  DEPOSIT
  CASH
}

enum PermissionAnswer {
  YES
  NO
}

enum Channel {
  TEACHER
  OFFICE
}

enum Currency {
  CRC
  USD
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id        String   @id @default(cuid())
  name      String
  shortName String
  city      String
  currency  String   @default("CRC")
  email     String?
  // Cuenta para depósitos y transferencias (se configura en la plataforma)
  bankName          String?
  bankAccountHolder String?
  bankHolderId      String?
  bankIban          String?
  sinpePhone        String?
  paymentNote       String?
  /// Horario en que el personal responde mensajes (informativo para las familias)
  messageHours      String?
  /// Chat familia ↔ escuela dentro de la plataforma (la escuela puede apagarlo si prefiere WhatsApp)
  messagingEnabled  Boolean @default(true)
  /// Recordatorios automáticos de cobro (3 días antes y días 1, 8, 15 y 30 de atraso)
  remindersEnabled  Boolean @default(true)
  createdAt DateTime @default(now())

  conversations Conversation[]
  users         User[]
  applicants    Applicant[]
  schoolYears   SchoolYear[]
  levels        Level[]
  announcements Announcement[]
  events        Event[]
  feeConcepts   FeeConcept[]
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  role         Role
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  active       Boolean  @default(true)
  /// Aceptación del aviso de privacidad (Ley 8968)
  privacyAcceptedAt DateTime?
  /// Preferencias de correo
  emailNotices  Boolean @default(true)
  emailReceipts Boolean @default(true)
  /// Enlace privado del calendario (suscripción ICS en Google / iPhone)
  calendarToken String?  @unique
  createdAt    DateTime @default(now())

  tokens          AuthToken[]
  guardianOf      StudentGuardian[]
  teacherOf       Section[]          @relation("SectionTeacher")
  announcements   Announcement[]
  reads           AnnouncementRead[]
  attendanceTaken Attendance[]
  paymentsLogged  Payment[]
  reportsSent     PaymentReport[]    @relation("ReportedPayments")
  conversations   Conversation[]     @relation("GuardianConversations")
  messages        Message[]
  convReads       ConversationRead[]
  pushSubs        PushSubscription[]
  absenceNotices  AbsenceNotice[]
  permissionAnswers PermissionResponse[]
  reportsReviewed PaymentReport[]    @relation("ReviewedPayments")
}

model SchoolYear {
  id       String    @id @default(cuid())
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  name     String
  startsOn DateTime  @db.Date
  endsOn   DateTime  @db.Date
  active   Boolean   @default(false)
  sections Section[]
}

model Level {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  name          String
  order         Int
  schedule      String?
  phone         String?
  address       String?
  materials     String?
  grades        Grade[]
  announcements Announcement[]
  events        Event[]
  feeConcepts   FeeConcept[]
}

model Grade {
  id       String    @id @default(cuid())
  levelId  String
  level    Level     @relation(fields: [levelId], references: [id])
  name     String
  order    Int
  sections   Section[]
  applicants Applicant[]
}

model Section {
  id            String         @id @default(cuid())
  gradeId       String
  grade         Grade          @relation(fields: [gradeId], references: [id])
  schoolYearId  String
  schoolYear    SchoolYear     @relation(fields: [schoolYearId], references: [id])
  name          String
  color         String         @default("green")
  teacherId     String?
  teacher       User?          @relation("SectionTeacher", fields: [teacherId], references: [id])
  students      Student[]
  announcements Announcement[]
  events        Event[]
}

model Student {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  firstName    String
  lastName     String
  idNumber     String?
  birthDate    DateTime @db.Date
  bloodType    String?
  allergies    String?
  medicalNotes String?
  /// Autorización de la familia para aparecer en fotos (null = sin responder)
  photoConsent Boolean?
  createdAt    DateTime @default(now())

  guardians  StudentGuardian[]
  pickups    AuthorizedPickup[]
  attendance Attendance[]
  charges    Charge[]
  payments   Payment[]
  reports    PaymentReport[]
  conversations Conversation[]
  absenceNotices AbsenceNotice[]
  permissionAnswers PermissionResponse[]
}

model StudentGuardian {
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship String
  isPrimary    Boolean @default(false)

  @@id([studentId, userId])
}

model AuthorizedPickup {
  id           String  @id @default(cuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  idNumber     String
  relationship String
  phone        String?
}

model Announcement {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id])
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  title       String
  body        String
  audience    Audience
  levelId     String?
  level       Level?             @relation(fields: [levelId], references: [id])
  sectionId   String?
  section     Section?           @relation(fields: [sectionId], references: [id])
  requiresAck Boolean            @default(true)
  /// Pide autorización por alumno (p. ej. una gira): Sí / No
  permissionQuestion String?
  permissionDeadline DateTime?  @db.Date
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]
  images      AnnouncementImage[]
  permissionAnswers PermissionResponse[]
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())
  acknowledgedAt DateTime?

  @@id([announcementId, userId])
}

model Event {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean  @default(false)
  kind        String   @default("evento")
  audience    Audience @default(SCHOOL)
  levelId     String?
  level       Level?   @relation(fields: [levelId], references: [id])
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String?
  recordedBy   User?            @relation(fields: [recordedById], references: [id])
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
}

model FeeConcept {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  name          String
  defaultAmount Int
  currency      Currency @default(CRC)
  recurring     Boolean  @default(false)
  /// Nivel al que aplica (null = todos)
  levelId       String?
  level         Level?   @relation(fields: [levelId], references: [id])
  /// Monto con descuento en los meses indicados (1-12), p. ej. matrícula ago-set
  earlyAmount   Int?
  earlyMonths   Int[]
  dueNote       String?
  charges       Charge[]
}

model Charge {
  id          String      @id @default(cuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptId   String?
  concept     FeeConcept? @relation(fields: [conceptId], references: [id])
  description String
  period      String?
  amount      Int
  currency    Currency    @default(CRC)
  dueDate     DateTime    @db.Date
  createdAt   DateTime    @default(now())

  @@unique([studentId, conceptId, period])
}

model Payment {
  id          String        @id @default(cuid())
  receiptNumber Int         @unique @default(autoincrement())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Int
  currency    Currency      @default(CRC)
  method      PaymentMethod
  reference   String?
  paidAt      DateTime      @db.Date
  note        String?
  loggedById  String?
  loggedBy    User?         @relation(fields: [loggedById], references: [id])
  createdAt   DateTime      @default(now())
  report      PaymentReport?
}

/// Pago reportado por una familia con su comprobante; Secretaría lo aprueba o rechaza.
model PaymentReport {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User          @relation("ReportedPayments", fields: [reportedById], references: [id])
  amount       Int
  currency     Currency      @default(CRC)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @db.Date
  concept      String
  note         String?
  fileName     String
  mimeType     String
  fileData     Bytes
  status       ReportStatus  @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("ReviewedPayments", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  paymentId    String?       @unique
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  createdAt    DateTime      @default(now())
}

model AuthToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

model Applicant {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id])
  status           ApplicantStatus     @default(NEW)
  gradeId          String?
  grade            Grade?              @relation(fields: [gradeId], references: [id])
  forYear          String
  childFirstName   String
  childLastName    String
  childIdNumber    String?
  childBirthDate   DateTime            @db.Date
  allergies        String?
  previousSchool   String?
  guardianName     String
  guardianIdNumber String?
  guardianEmail    String
  guardianPhone    String
  relationship     String
  message          String?
  transfer         Boolean             @default(false)
  checklist        String[]
  staffNotes       String?
  studentId        String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  documents        ApplicantDocument[]
}

model ApplicantDocument {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  kind        String
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now())
}

/// Hilo entre un encargado y la escuela sobre un alumno: con la docente guía o con la oficina.
model Conversation {
  id            String             @id @default(cuid())
  schoolId      String
  school        School             @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId    String
  guardian      User               @relation("GuardianConversations", fields: [guardianId], references: [id], onDelete: Cascade)
  channel       Channel
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  messages      Message[]
  reads         ConversationRead[]

  @@unique([studentId, guardianId, channel])
  @@index([schoolId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@id([conversationId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

/// Ajustes generados por la aplicación (p. ej. claves VAPID si no vienen en variables de entorno)
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

/// Imagen de un aviso (muchas circulares son solo una imagen hecha en Canva)
model AnnouncementImage {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  mimeType       String
  size           Int
  data           Bytes
  order          Int          @default(0)
}

/// La familia avisa que su hijo no asistirá (o llegará tarde) y por qué.
model AbsenceNotice {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  dateFrom   DateTime @db.Date
  dateTo     DateTime @db.Date
  reason     String
  note       String?
  createdAt  DateTime @default(now())

  @@index([studentId, dateFrom, dateTo])
}

/// Respuesta de una familia a un aviso que pide autorización, por alumno.
model PermissionResponse {
  announcementId String
  announcement   Announcement     @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId     String
  guardian       User             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  answer         PermissionAnswer
  note           String?
  respondedAt    DateTime         @default(now())

  @@id([announcementId, studentId])
}

/// Registro de recordatorios enviados, para no repetirlos el mismo día.
model ReminderLog {
  id         String   @id @default(cuid())
  guardianId String
  kind       String
  day        DateTime @db.Date
  detail     String?
  createdAt  DateTime @default(now())

  @@unique([guardianId, kind, day])
}
